@model WebUser

@{
    ViewData["Title"] = "Slett bruker";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Slett konto</h2>

<h3>Er du sikker på at du vil slette brukeren din?</h3>
<div>
    <h4>@Model.UserName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>
    </dl>
</div>

<form asp-action="DeleteSelf" method="post">
    <!-- CSRF-beskyttelse -->
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <input type="submit" value="Slett" class="btn btn-danger" /> |
        <a asp-action="UserPage" asp-controller="Account" class="btn btn-secondary">Avbryt</a>
    </div>
</form>
