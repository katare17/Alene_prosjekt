@model WebUser

@{
    ViewData["Title"] = "Slett bruker";
    Layout = "~/Views/Shared/CaseworkerLayout.cshtml";
}
<h3>Vil du slette denne brukeren?</h3>
<div>
    <h4>@Model.UserName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Email
        </dt>
        <dd class="col-sm-10">
            @Model.Email
        </dd>
    </dl>
</div>

<form asp-action="DeleteUser" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <input type="submit" value="Slett" class="btn btn-danger" /> |
        <a asp-action="CaseworkerPage" class="btn btn-secondary">Cancel</a>
    </div>
</form>
