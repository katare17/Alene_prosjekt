@model List<WebApplication1.Data.GeoChange>
@using Microsoft.AspNetCore.Identity
@inject UserManager<WebUser> UserManager
@{
    ViewData["Title"] = "Approved Reports";
    Layout = "~/Views/Shared/CaseworkerLayout.cshtml";

    // Henter inn den innloggede brukeren (for brukerrelatert visning)
    var user = await UserManager.GetUserAsync(User);

    // Lager en dictionary hvor brukerepost lagres
    var userEmails = new Dictionary<string, string>();

    // Henter epostene til brukerne
    foreach (var change in Model)
    {
        if (!userEmails.ContainsKey(change.UserId))
        {
            var applicationUser = await UserManager.FindByIdAsync(change.UserId);
            if (applicationUser != null)
            {
                userEmails[change.UserId] = applicationUser.Email;
            }
        }
    }

    // Filtrerer alle som er godkjent inn i en liste
    var filteredModel = Model.Where(change => change.IsApproved == true).ToList();
}

<div class="container mt-5">
<h2 class="text-center">Godkjente rapporter</h2>
</div>
<div class="container mt-5">
    <div id="map" style="height: 500px; width: 100%; border: 3px solid #ccc;"></div>
</div>

<div class="container mt-5">
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fylke</th>
                <th>Kommune</th>
                <th>Beskrivelse</th>
                <th>Epost</th>
                <th>Avslå</th>
                <th>Slett</th>
                <th>Slett bruker</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var change in filteredModel)
            {
                <tr>
                    <td>@change.Id</td>
                    <td>@change.Fylkesnavn</td>
                    <td>@change.Kommunenavn</td>
                    <td>@change.Description</td>
                    <td>
                        @{
                            if (userEmails.TryGetValue(change.UserId, out var email))
                            {
                                @Html.Encode(email)
                            }
                            else
                            {
                                @Html.Encode("Ingen")
                            }
                        }
                    </td>
                    @* Lager to knapper for å avslå eller slette rapporter *@

                    <td>
                        <form asp-controller="Account" asp-action="Reject" method="post">
                            <input type="hidden" name="id" value="@change.Id" />
                            <input type="submit" value="Avslå" class="btn btn-danger" />
                        </form>
                    </td>
                    <td>
                        <div class="edit-delete-links">
                            <a asp-controller="Account" class="btn btn-danger" asp-action="CaseworkerDelete" asp-route-id="@change.Id" asp-route-returnUrl="@Url.Action("ApprovedReports", "Account")">Slett</a>
                        </div>
                    </td>
                    <td>
                        <div class="edit-delete-links">
                            <a asp-controller="Account" asp-action="DeleteUser" asp-route-id="@change.UserId">Slett Bruker</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var map = L.map('map').setView([58.160048, 8.003007], 13);

            L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
                attribution: 'Kartdata &copy; <a href="https://www.kartverket.no/">Kartverket</a>'
            }).addTo(map);

            var changes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(filteredModel));

            changes.forEach(function (element) {
                try {
                    console.log("Processing element:", element); // Debuggingslinje

                    var geoJsonData = typeof element.GeoJson === "string"
                        ? JSON.parse(element.GeoJson) // Om det er en String så parses den
                        : element.GeoJson; // Ellers så brukes den som den er

                    console.log("Parsed GeoJSON:", geoJsonData); // Debuggingslinje

                    if (geoJsonData) {
                        var popupContent = `<strong>ID:</strong> ${element.Id}<br><strong>Description:</strong> ${element.Description}`;
                        L.geoJSON(geoJsonData).bindPopup(popupContent).addTo(map);
                    } else {
                        console.error("Invalid GeoJSON for element:", element);
                    }
                } catch (error) {
                    console.error("Error parsing GeoJSON:", error);
                }
            });
        });
    </script>
}
